{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task.schema.json",
  "title": "Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "epic",
    "feature",
    "title",
    "type",
    "status",
    "priority",
    "objective",
    "depends_on",
    "references",
    "context",
    "scope",
    "requirements",
    "acceptance_criteria",
    "non_goals",
    "validation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]{3}$"
    },
    "epic": {
      "type": "string",
      "pattern": "^EPIC-[A-Z0-9-]+$"
    },
    "feature": {
      "type": "string",
      "pattern": "^FEAT-[A-Z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "type": {
      "enum": [
        "architecture",
        "database",
        "backend",
        "frontend",
        "design-system",
        "integration",
        "test",
        "documentation",
        "refactor",
        "bugfix",
        "tooling"
      ]
    },
    "status": {
      "enum": [
        "planned",
        "ready",
        "in_progress",
        "implemented",
        "validating",
        "in_review",
        "rework",
        "blocked",
        "done"
      ]
    },
    "priority": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 10
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "screens": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "docs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "api": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "screens",
        "docs",
        "api"
      ]
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "optional"
      ],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apps",
        "allowed_areas"
      ],
      "properties": {
        "apps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_areas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "verification",
          "blocking"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-[0-9]{2}$"
          },
          "description": {
            "type": "string",
            "minLength": 5
          },
          "verification": {
            "enum": [
              "automated",
              "review",
              "manual"
            ]
          },
          "blocking": {
            "type": "boolean"
          }
        }
      }
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commands"
      ],
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
